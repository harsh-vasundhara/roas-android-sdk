<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Beacons go to the ROASSensor collector over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading the GAID on Android 12+ requires this normal-level permission.
         Omit it (or the host app can revoke it) to run without an ad id — the
         SDK degrades to referrer-only attribution rather than failing. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Android 11+ package visibility hides other installed apps by default,
         and querying a hidden one throws NameNotFoundException rather than
         returning null. We read the Play Store's own version because THAT — not
         the Android release — is what gates the Install Referrer API, and it is
         the difference between "this device's Play Store is too old to answer"
         and "this install was genuinely organic". Declaring one package is the
         narrow form of this permission: it grants visibility of Play only, not
         the <queries> wildcard. -->
    <queries>
        <package android:name="com.android.vending" />
        <!-- Play SERVICES, a different package from the Play Store above and the
             answer to a different question: it is what `AdvertisingIdClient`
             binds to, so its version is what separates "the user opted out of
             the ad id" from "this device's Play Services is stale or absent". -->
        <package android:name="com.google.android.gms" />

        <!-- The OEM-native referrer ContentProviders (VivoReferrerReader,
             HuaweiReferrerReader). WITHOUT these entries those two readers
             cannot work at all on any app targeting API 30+, which is every
             app Play now accepts: package visibility hides the provider, the
             ContentResolver call throws, and the reader reports a perfectly
             clean NOT_AVAILABLE — indistinguishable from "this device has no
             OEM store". Found exactly that way on a real vivo V2130: an
             `adb shell content call` against the authority answered fine
             (shell has broad visibility) while the SAME call from inside the
             app returned nothing.

             The Xiaomi and Samsung paths do NOT need an entry here only
             because their official vendor AARs declare their own visibility,
             which manifest-merges into the host app — which is also why those
             two worked on real hardware while these two silently did not.

             Declared as <provider> authorities rather than <package> names on
             purpose: it is the provider we actually resolve, the authority is
             the thing our code names, and it keeps this list checkable
             one-to-one against the readers' own constants. -->
        <provider android:authorities="com.vivo.appstore.provider.referrer" />
        <!-- Same store, different package name on some builds (confirmed on
             Indian-market V2130/V2142, which ship it as com.vivo.apprecommend)
             — see VivoReferrerReader.AUTHORITIES. -->
        <provider android:authorities="com.vivo.apprecommend.provider.referrer" />
        <provider android:authorities="com.huawei.appmarket.commondata" />
    </queries>

    <application>
        <!-- The legacy INSTALL_REFERRER broadcast — several OEM app stores
             (Huawei AppGallery, Xiaomi GetApps, Vivo App Store, Samsung Galaxy
             Store, Amazon Appstore) still send it for compatibility with older
             marketing SDKs, even though it predates Google's own Install
             Referrer API. InstallReferrerReader only ever asks Play; an install
             from any other store gets FEATURE_NOT_SUPPORTED from that API and
             nothing else, indistinguishable from organic, unless this catches
             it instead. Must be manifest-declared (not runtime-registered): the
             broadcast can arrive before the app has ever been launched, and
             only a manifest receiver gets a fresh process spun up to deliver
             it. exported="true" is required (Android 12+ mandates an explicit
             value on any component with an intent-filter) and is correct here
             regardless: the sender is another app (the store), so this must be
             reachable across the process boundary. -->
        <receiver
            android:name=".InstallReferrerBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
