# Copy to keystore.properties (gitignored) and fill in real values, or generate
# a fresh keystore with:
#
#   keytool -genkeypair -v -keystore release.keystore.jks -alias roas-sample \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file present, `assembleRelease`/`bundleRelease` falls back to
# debug signing — fine for local testing, but Play Console will reject an
# upload signed with the debug key.
storeFile=release.keystore.jks
storePassword=
keyAlias=roas-sample
keyPassword=
